{
  "name": "@ferrazio/sdk",
  "version": "7.12.0",
  "description": "Official Node.js SDK for the Ferrazio API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ferrazio/sdk-node.git"
  },
  "bugs": {
    "url": "https://github.com/Ferrazio/sdk-node/issues"
  },
  "homepage": "https://github.com/Ferrazio/sdk-node#readme",
  "keywords": [
    "ferrazio",
    "sdk",
    "api",
    "typescript",
    "react-native"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./openapi/*": "./openapi/*"
  },
  "files": [
    "dist",
    "docs/api.md",
    "openapi/edge-contract.json",
    "openapi/openapi.min.json.gz",
    "openapi/version.json",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "tsup",
    "prepack": "bun scripts/pack-openapi.ts",
    "prepublishOnly": "bun run typecheck && bun test && bun run build",
    "pack:openapi": "bun scripts/pack-openapi.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
